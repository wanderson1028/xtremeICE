{
  "name": "TrainingExerciseAttempt",
  "type": "object",
  "properties": {
    "exercise_id": {
      "type": "string"
    },
    "exercise_title": {
      "type": "string"
    },
    "exercise_owner_id": {
      "type": "string",
      "description": "Creator of the exercise, so they can review attempts on their exercises"
    },
    "organization_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ids of the exercise tasks the learner marked complete"
    },
    "task_total": {
      "type": "number"
    },
    "score": {
      "type": "number",
      "description": "Percentage of tasks completed"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed"
      ],
      "default": "completed",
      "enumColors": [
        "yellow",
        "green"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "exercise_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.exercise_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}