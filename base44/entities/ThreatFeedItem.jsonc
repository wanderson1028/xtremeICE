{
  "name": "ThreatFeedItem",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "CISA-KEV",
        "NVD-CVE",
        "GHSA"
      ],
      "description": "Feed source"
    },
    "external_id": {
      "type": "string",
      "description": "Unique ID from the source feed (CVE ID, KEV catalog ID, or GHSA ID)"
    },
    "cve_id": {
      "type": "string",
      "description": "CVE identifier (e.g. CVE-2024-12345)"
    },
    "title": {
      "type": "string",
      "description": "Short title / vulnerability name"
    },
    "description": {
      "type": "string",
      "description": "Description of the vulnerability / exploit"
    },
    "severity": {
      "type": "number",
      "description": "CVSS score (0-10)"
    },
    "severity_label": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Severity bucket derived from CVSS"
    },
    "epss_score": {
      "type": "number",
      "description": "EPSS exploit-likelihood score (0-1) from FIRST.org; higher = more likely to be exploited"
    },
    "epss_percentile": {
      "type": "number",
      "description": "EPSS percentile (0-1) \u2014 rank relative to all scored CVEs"
    },
    "affected_products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Affected vendor/product/version strings"
    },
    "mitre_techniques": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MITRE ATT&CK technique IDs associated with this vulnerability"
    },
    "published_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the vulnerability was published or added to the feed"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last ingested from the feed"
    },
    "raw": {
      "type": "object",
      "description": "Slim subset of the original feed payload (kept small to avoid oversized records)"
    }
  },
  "required": [
    "source",
    "external_id",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}