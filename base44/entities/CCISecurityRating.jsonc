{
  "properties": {
    "baseline_score": {
      "default": 600,
      "type": "number"
    },
    "calculated_at": {
      "format": "date-time",
      "type": "string"
    },
    "calculation_version": {
      "type": "string"
    },
    "external_references": {
      "description": "Future API connection identifiers without credentials",
      "type": "object"
    },
    "factors": {
      "type": "object"
    },
    "final_score": {
      "type": "number"
    },
    "organization_id": {
      "description": "Organization or individual profile key",
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "rating_band": {
      "type": "string"
    },
    "score_change": {
      "type": "number"
    },
    "vpentest_score": {
      "description": "Normalized 0-100 vPentest resilience score; higher is better",
      "type": "number"
    },
    "vpentest_source": {
      "default": "pending",
      "enum": [
        "pending",
        "manual",
        "api"
      ],
      "type": "string"
    },
    "vulscan_score": {
      "description": "Normalized 0-100 VulScan posture score; higher is better",
      "type": "number"
    },
    "vulscan_source": {
      "default": "pending",
      "enum": [
        "pending",
        "manual",
        "api"
      ],
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "baseline_score",
    "final_score",
    "rating_band"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object",
  "name": "CCISecurityRating"
}