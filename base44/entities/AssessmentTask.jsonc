{
  "name": "AssessmentTask",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "mcq",
        "matching",
        "manual"
      ],
      "default": "manual",
      "description": "Question format. Objective types (mcq, matching) are scored automatically using the stored answer key."
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Multiple-choice options as { id, text }"
    },
    "correct_option_id": {
      "type": "string",
      "description": "Answer key for multiple-choice questions"
    },
    "matching_prompts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Items the candidate must match, as { id, text }"
    },
    "matching_choices": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Match options presented to the candidate, as { id, text }"
    },
    "matching_answer": {
      "type": "object",
      "description": "Answer key for matching questions: prompt id \u2192 choice id"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "Investigation",
        "Configuration",
        "Analysis",
        "Documentation",
        "Remediation",
        "Scripting",
        "Verification",
        "Knowledge Check"
      ]
    },
    "tools_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nice_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "points": {
      "type": "number",
      "default": 10
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scoring_criteria": {
      "type": "object"
    }
  },
  "required": [
    "assessment_id",
    "title",
    "order",
    "task_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}