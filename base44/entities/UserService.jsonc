{
  "name": "UserService",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user assigned this service"
    },
    "service_key": {
      "type": "string",
      "description": "The service/feature assigned to the user. Matches a FeatureFlag key."
    },
    "access_level": {
      "type": "string",
      "enum": [
        "editor",
        "viewer"
      ],
      "default": "editor",
      "description": "Permission inside the feature. 'editor' can create and change records; 'viewer' is read-only. Assignments made before this field existed have no value and keep full use of the feature, so they resolve to editor."
    }
  },
  "required": [
    "user_email",
    "service_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}