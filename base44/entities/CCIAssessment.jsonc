{
  "name": "CCIAssessment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "source_assessment_date": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative vPenTest assessment date or best verified report date"
    },
    "business_address": {
      "type": "string"
    },
    "poc_name": {
      "type": "string"
    },
    "poc_email": {
      "type": "string"
    },
    "poc_phone": {
      "type": "string"
    },
    "source_mode": {
      "type": "string",
      "enum": [
        "upload",
        "api"
      ],
      "default": "upload"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "analyzing",
        "completed",
        "failed"
      ]
    },
    "report_fingerprint": {
      "type": "string",
      "description": "Stable report-set identity used for repeatable scoring"
    },
    "report_files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_count": {
      "type": "number",
      "default": 0
    },
    "revision_of_id": {
      "type": "string"
    },
    "revision_number": {
      "type": "number",
      "default": 1
    },
    "assessment_dates": {
      "type": "object"
    },
    "vulnerability_counts": {
      "type": "object"
    },
    "vulnerability_findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pentest_findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attack_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "vulnerability_score": {
      "type": "number"
    },
    "penetration_test_score": {
      "type": "number"
    },
    "baseline_score": {
      "type": "number",
      "default": 650
    },
    "final_score": {
      "type": "number"
    },
    "rating_band": {
      "type": "string"
    },
    "score_change": {
      "type": "number"
    },
    "data_confidence": {
      "type": "string",
      "enum": [
        "current",
        "expiring",
        "expired",
        "unknown"
      ]
    },
    "confidence_message": {
      "type": "string"
    },
    "is_current_rating": {
      "type": "boolean"
    },
    "scoring_breakdown": {
      "type": "object"
    },
    "executive_summary": {
      "type": "string"
    },
    "primary_deduction": {
      "type": "string"
    },
    "coverage_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_analysis_status": {
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed",
        "not_required"
      ]
    },
    "evidence_analysis_progress": {
      "type": "number"
    },
    "evidence_analysis_message": {
      "type": "string"
    },
    "calculation_version": {
      "type": "string"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_updated_by": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "business_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}